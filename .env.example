# Server Port (Default: 5000)
PORT=5000

# Environment mode
NODE_ENV=development

# Supabase Client — anon key only. NEVER use or store service_role keys here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# (Aliases supported: SUPABASE_KEY, VITE_SUPABASE_ANON_KEY)

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://your-app.example
# (Aliases supported: FRONTEND_URL, VITE_FRONTEND_URL)
